{
  "name": "bdl-pool-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cargo run --manifest-path site/Cargo.toml && python3 -m http.server 3000 --directory out --bind 127.0.0.1",
    "build": "cargo run --locked --release --manifest-path site/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "preview": "python3 -m http.server 3000 --directory out --bind 127.0.0.1",
    "check:rust": "cargo test --locked --manifest-path site/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
