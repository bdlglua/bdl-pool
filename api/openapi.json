{
  "openapi": "3.1.0",
  "info": {
    "title": "BDL Pool API",
    "version": "1.1.0",
    "description": "Public, read-only pool and per-address CKPool statistics. Global snapshots update every five minutes; miner records follow CKPool. Check updatedAt/stale. HTTP 404 is expected until the first share has been recorded. Hashrates are H/s. No directory of miner addresses is exposed. Live authorised connections are collected every 15 seconds. Presence older than 45 seconds is unavailable. The online list masks addresses and removes address prefixes from worker names; per-address results use the supplied address. Devices are based on self-reported Stratum user-agents, with unknown models left null."
  },
  "servers": [
    {
      "url": "https://bdl-pool.duckdns.org"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "API process health (not mining availability)",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Public measurements; unknown numbers are null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Endpoint, address or worker not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Statistics unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
