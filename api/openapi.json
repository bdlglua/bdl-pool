    "/api/v1/online": {
      "get": {
        "summary": "Current authorised Stratum connections with masked Bitcoin addresses",
        "description": "One row per connection. Fresh CKPool clients data is required; stale or unavailable presence returns available=false, total=null and no rows. Hardware models are only reported when advertised in the Stratum user-agent. No raw user-agent, client IP or full wallet address is exposed.",
        "operationId": "getOnlineMiners",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
